everytime_raw_reviews.json
everytime_teachers.json
*.raw.json
crawl_cache/
temp/
tmp/
*.tmp

# 5. Node, NPM & Build Caches
node_modules/
.npm/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. Deployment & Cloud Artifacts
.vercel/

